# Required. User or team service-account API key for the Cursor SDK / Cloud Agents.
# This is NOT on the Integrations page (that page is for GitHub, Linear, Slack, etc.).
# Create one here instead:
#   https://cursor.com/dashboard/api
# Docs: https://cursor.com/docs/api  and  https://cursor.com/docs/sdk/typescript
# Put the value in this env var (or pass apiKey in code). Format is often crsr_...
CURSOR_API_KEY=

# Required for `pe-loop start <ticket>` intake. Personal API key from
# https://linear.app/settings/api
# Note: connecting Linear under Cursor Dashboard → Integrations lets Cloud Agents
# use Linear inside the IDE; this LINEAR_API_KEY is what *our orchestrator* uses
# to fetch the ticket before starting the agent.
LINEAR_API_KEY=

# Comma-separated GitHub repo URLs the Product Engineer may touch.
# Example: https://github.com/descasio/frontend,https://github.com/descasio/backend
# Those repos must be available to your Cursor account (GitHub connected under
# Dashboard → Integrations → Source Control).
PE_REPOS=

# Optional. Default branch / starting ref for cloud clones (default: main).
PE_STARTING_REF=main

# Optional. Model id (default: composer-2.5). Use Cursor.models.list() to discover.
PE_MODEL=composer-2.5

# Optional. Directory for ticket run state (default: .runs next to this package).
# PE_RUNS_DIR=
